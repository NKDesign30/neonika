# Neon Core — example environment
#
# Copy to `.env` and adjust. Every value below is OPTIONAL: Neon Core boots with
# safe defaults and, per the shadow contract, never sends, mutates, or executes
# anything until a cutover stage is explicitly armed.
#
# Never commit `.env` — it is gitignored.

# ─── Gateway ────────────────────────────────────────────────────────────────
# Host and port for the HTTP gateway / Mission Control dashboard.
# NEON_CORE_HOST=127.0.0.1
# NEON_CORE_PORT=8788

# ─── Memory ─────────────────────────────────────────────────────────────────
# Path to the SQLite semantic-memory database (FTS5). Read-only by default.
# NEON_MEMORY_DB_PATH=./data/semantic-memory.db
#
# Optional external memory-search CLI. When unset, the SQLite provider is used
# and the CLI fallback reports "not configured" instead of probing your disk.
# NEON_MEMORY_SEARCH_COMMAND=/usr/local/bin/memory-search

# ─── Skills & Extensions ────────────────────────────────────────────────────
# Optional reference checkout scanned for importable skills and extensions.
# When unset, the inventory reports "missing" rather than scanning the CWD.
# NEON_SKILL_REFERENCE_ROOT=/path/to/reference/checkout

# ─── Channels: Discord ──────────────────────────────────────────────────────
# NEON_DISCORD_BOT_TOKEN=
# NEON_DISCORD_BOT_USER_ID=
# NEON_DISCORD_ALLOWED_GUILDS=

# ─── Cutover stage ──────────────────────────────────────────────────────────
# shadow (default) -> mirror -> canary -> primary
# Outbound delivery stays suppressed until BOTH the stage and the matching
# approval flag are set. Leave these alone unless you know what you are arming.
# NEON_CUTOVER_STAGE=shadow
# NEON_CUTOVER_OUTBOUND_ENABLED=false
