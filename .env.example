# Neonika — example environment
#
# Copy to `.env` and adjust. Every value below is OPTIONAL: Neonika boots with
# safe defaults and never sends, mutates, or executes anything until the
# corresponding gate is explicitly armed. Outbound additionally requires an
# eligible cutover stage and approval.
#
# Never commit `.env` — it is gitignored.

# ─── Gateway ────────────────────────────────────────────────────────────────
# Host and port for the HTTP gateway / Mission Control dashboard.
# NEONIKA_HOST=127.0.0.1
# NEONIKA_PORT=8788

# ─── Supervised runtime service ─────────────────────────────────────────────
# Keep the production runtime environment in ~/.neonika/runtime.env with mode
# 0600. Values are loaded only by the supervised process and are never copied
# into the launchd plist, systemd user unit, manifest, or operation history.
# Every service mutation is default-off and needs the exact value `ready` on
# the operator invocation; do not store this gate in runtime.env.
# Any other value is reported as `invalid-value`.
# NEON_RUNTIME_SERVICE_MUTATIONS_ENABLED=ready
#
# Predecessor stand-down is a separate operation allowed only while Primary is
# healthy and the persisted Retire evidence gate passes. Both values are JSON
# argv arrays with an absolute executable path, never shell command text.
# NEON_PREDECESSOR_STAND_DOWN_ARGV=["/absolute/path/to/legacy-control","stand-down"]
# NEON_PREDECESSOR_ROLLBACK_ARGV=["/absolute/path/to/legacy-control","restore"]

# Optional Sites dashboard. The list stays empty until explicitly configured.
# Analytics execution uses execFile without a shell and only the configured
# executable; the dashboard never invents site or reach data.
# NEONIKA_SITES_JSON=[{"property":"example","label":"Example","domain":"example.com"}]
# NEONIKA_SITE_ANALYTICS_COMMAND=/absolute/path/to/analytics-cli

# ─── Memory ─────────────────────────────────────────────────────────────────
# Path to the SQLite semantic-memory database (FTS5). Read-only by default.
# NEON_MEMORY_DB_PATH=./data/semantic-memory.db
# Productive live-index promotion requires the same database through a second
# explicit target, a private backup directory, and both write gates. Every
# non-empty batch creates and verifies a pre-write snapshot before one atomic
# transaction. Keep these gates off until `live-index-production-check` passes.
# NEON_LIVE_INDEX_MEMORY_DB_PATH=./data/semantic-memory.db
# NEON_MEMORY_BACKUP_DIR=./state/memory-backups
# NEON_MEMORY_WRITE_ENABLED=false
# NEON_LIVE_INDEX_WRITEBACK_ENABLED=false
# NEON_LIVE_INDEX_DAEMON_ENABLED=false
#
# Restore is a separate one-command gate. Arm it only for a stopped writer,
# restore one snapshot id, verify the result, then disarm it again.
# NEON_MEMORY_ROLLBACK_ENABLED=false
#
# Optional external memory-search CLI. When unset, the SQLite provider is used
# and the CLI fallback reports "not configured" instead of probing your disk.
# NEON_MEMORY_SEARCH_COMMAND=/usr/local/bin/memory-search

# ─── Automation ─────────────────────────────────────────────────────────────
# Daemon loop, intent timer, and agent execution are independent gates. With
# only daemon + timer armed, Neonika persists terminal shadow markers and
# invokes no harness. Agent execution stays read-only and retries classified
# transient harness failures at most twice by default (hard cap: three).
# NEON_CRON_DAEMON_ENABLED=false
# NEON_CRON_TIMER_ENABLED=false
# NEON_HEARTBEAT_DAEMON_ENABLED=false
# NEON_HEARTBEAT_TIMER_ENABLED=false
# NEON_SCHEDULED_AGENT_EXECUTION_ENABLED=false
# NEON_SCHEDULED_AGENT_MAX_ATTEMPTS=2

# ─── Skills & Extensions ────────────────────────────────────────────────────
# Optional reference checkout scanned for importable skills and extensions.
# When unset, the inventory reports "missing" rather than scanning the CWD.
# NEON_SKILL_REFERENCE_ROOT=/path/to/reference/checkout

# ─── Channels: Discord ──────────────────────────────────────────────────────
# NEON_DISCORD_BOT_TOKEN=
# NEON_DISCORD_BOT_USER_ID=
# NEON_DISCORD_ALLOWED_GUILDS=

# ─── Channels: WhatsApp canary ─────────────────────────────────────────────
# The ordinary whatsapp-shadow-tap never sends. The separate owner-only canary
# accepts only `/neon ...` commands and needs this exact runtime-only flag plus
# the persisted Canary approval and outbound arm. It rejects groups and other
# peers. Keep the flag out of shared shells and use `disarm-outbound` to stop
# subsequent sends immediately.
# NEON_WHATSAPP_CANARY_OUTBOUND_ENABLED=ready

# ─── Cutover stage ──────────────────────────────────────────────────────────
# shadow -> mirror -> canary -> primary (fresh-install default) -> retire
# Outbound delivery stays suppressed until BOTH the stage and the matching
# approval flag are set. Leave these alone unless you know what you are arming.
# NEON_CUTOVER_STAGE=shadow
# NEON_CUTOVER_OUTBOUND_ENABLED=false
