# Neonika — example environment
#
# Copy to `.env` and adjust. Every value below is OPTIONAL: Neonika boots with
# safe defaults and never sends, mutates, or executes anything until the
# corresponding gate is explicitly armed. Outbound additionally requires an
# eligible cutover stage and approval.
#
# Never commit `.env` — it is gitignored.

# ─── Gateway ────────────────────────────────────────────────────────────────
# Host and port for the HTTP gateway / Mission Control dashboard.
# NEONIKA_HOST=127.0.0.1
# NEONIKA_PORT=8788

# Optional Sites dashboard. The list stays empty until explicitly configured.
# Analytics execution uses execFile without a shell and only the configured
# executable; the dashboard never invents site or reach data.
# NEONIKA_SITES_JSON=[{"property":"example","label":"Example","domain":"example.com"}]
# NEONIKA_SITE_ANALYTICS_COMMAND=/absolute/path/to/analytics-cli

# ─── Memory ─────────────────────────────────────────────────────────────────
# Path to the SQLite semantic-memory database (FTS5). Read-only by default.
# NEON_MEMORY_DB_PATH=./data/semantic-memory.db
#
# Optional external memory-search CLI. When unset, the SQLite provider is used
# and the CLI fallback reports "not configured" instead of probing your disk.
# NEON_MEMORY_SEARCH_COMMAND=/usr/local/bin/memory-search

# ─── Automation ─────────────────────────────────────────────────────────────
# Daemon loop, intent timer, and agent execution are independent gates. With
# only daemon + timer armed, Neonika persists terminal shadow markers and
# invokes no harness. Agent execution stays read-only and retries classified
# transient harness failures at most twice by default (hard cap: three).
# NEON_CRON_DAEMON_ENABLED=false
# NEON_CRON_TIMER_ENABLED=false
# NEON_HEARTBEAT_DAEMON_ENABLED=false
# NEON_HEARTBEAT_TIMER_ENABLED=false
# NEON_SCHEDULED_AGENT_EXECUTION_ENABLED=false
# NEON_SCHEDULED_AGENT_MAX_ATTEMPTS=2

# ─── Skills & Extensions ────────────────────────────────────────────────────
# Optional reference checkout scanned for importable skills and extensions.
# When unset, the inventory reports "missing" rather than scanning the CWD.
# NEON_SKILL_REFERENCE_ROOT=/path/to/reference/checkout

# ─── Channels: Discord ──────────────────────────────────────────────────────
# NEON_DISCORD_BOT_TOKEN=
# NEON_DISCORD_BOT_USER_ID=
# NEON_DISCORD_ALLOWED_GUILDS=

# ─── Cutover stage ──────────────────────────────────────────────────────────
# shadow (default) -> mirror -> canary -> primary
# Outbound delivery stays suppressed until BOTH the stage and the matching
# approval flag are set. Leave these alone unless you know what you are arming.
# NEON_CUTOVER_STAGE=shadow
# NEON_CUTOVER_OUTBOUND_ENABLED=false
